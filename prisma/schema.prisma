generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(cuid())
  email             String          @unique
  password          String
  name              String
  dateOfBirth       DateTime
  role              Role           @default(PATIENT)
  emailVerified     Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  profile           Profile?
  healthProfile     HealthProfile?
  appointments      Appointment[]
  symptoms          SymptomLog[]
  payments          Payment[]
  goals             Goal[]
  activities        Activity[]
  moodLogs         MoodLog[]
  sleepLogs        SleepLog[]
  nutritionLogs    NutritionLog[]
  exerciseLogs     ExerciseLog[]
  medications      Medication[]
  journalEntries   JournalEntry[]
  communityPosts   CommunityPost[]
  comments         Comment[]
  achievements     Achievement[]
}

model HealthProfile {
  id                    String    @id @default(cuid())
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id])
  height                Float?    // en centímetros
  weight                Float?    // en kilogramos
  bloodType             String?
  lastPeriodDate        DateTime?
  menopauseStage        MenopauseStage?
  familyHistory         Json?     // historial familiar de condiciones médicas
  preExistingConditions Json?     // condiciones médicas preexistentes
  allergies             String[]
  medications           String[]
  supplements           String[]
  lifestyle             Lifestyle?
  stressLevel          Int?      // escala 1-10
  sleepQuality         Int?      // escala 1-10
  dietaryPreferences   String[]
  exerciseFrequency    ExerciseFrequency?
  updatedAt            DateTime  @updatedAt
}

model MoodLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime
  mood        MoodType
  intensity   Int       // escala 1-10
  triggers    String[]
  notes       String?
  activities  String[]  // actividades relacionadas con el estado de ánimo
  createdAt   DateTime  @default(now())
}

model SleepLog {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  date            DateTime
  hoursSlept      Float
  quality         Int       // escala 1-10
  nightSweats     Boolean
  interruptions   Int
  dreamActivity   String?
  notes           String?
  createdAt       DateTime  @default(now())
}

model NutritionLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime
  meals       Json[]    // array de comidas con detalles
  waterIntake Float     // en litros
  cravings    String[]
  supplements String[]
  notes       String?
  createdAt   DateTime  @default(now())
}

model ExerciseLog {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime
  type        ExerciseType
  duration    Int       // en minutos
  intensity   Int       // escala 1-10
  calories    Int?
  notes       String?
  createdAt   DateTime  @default(now())
}

model Medication {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  name        String
  dosage      String
  frequency   String
  startDate   DateTime
  endDate     DateTime?
  sideEffects String[]
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model JournalEntry {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  date        DateTime
  content     String
  mood        MoodType?
  tags        String[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  description String?
  category    GoalCategory
  startDate   DateTime
  endDate     DateTime?
  status      GoalStatus
  progress    Int       @default(0)
  activities  Activity[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Activity {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  goalId      String?
  goal        Goal?     @relation(fields: [goalId], references: [id])
  title       String
  description String?
  date        DateTime
  completed   Boolean   @default(false)
  notes       String?
  createdAt   DateTime  @default(now())
}

model CommunityPost {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  title       String
  content     String
  tags        String[]
  likes       Int       @default(0)
  comments    Comment[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Comment {
  id          String    @id @default(cuid())
  postId      String
  post        CommunityPost @relation(fields: [postId], references: [id])
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  content     String
  likes       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Achievement {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  type        AchievementType
  title       String
  description String
  points      Int
  unlockedAt  DateTime  @default(now())
}

enum Role {
  ADMIN
  PROFESSIONAL
  PATIENT
}

enum MenopauseStage {
  PERIMENOPAUSE
  EARLY_MENOPAUSE
  LATE_MENOPAUSE
  POST_MENOPAUSE
}

enum Lifestyle {
  SEDENTARY
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum ExerciseFrequency {
  NEVER
  RARELY
  SOMETIMES
  REGULARLY
  DAILY
}

enum MoodType {
  HAPPY
  CALM
  ANXIOUS
  IRRITABLE
  SAD
  ENERGETIC
  TIRED
  STRESSED
}

enum ExerciseType {
  WALKING
  RUNNING
  YOGA
  SWIMMING
  STRENGTH_TRAINING
  PILATES
  CYCLING
  OTHER
}

enum GoalCategory {
  PHYSICAL_HEALTH
  MENTAL_HEALTH
  NUTRITION
  SLEEP
  EXERCISE
  LIFESTYLE
  SOCIAL
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AchievementType {
  STREAK
  MILESTONE
  CHALLENGE
  COMMUNITY
  PROGRESS
}