rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isEmailVerified() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User collection rules
    match /users/{userId} {
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow read: if isAuthenticated() && (request.auth.uid == userId || request.auth.token.admin == true);
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false;
    }

    // Health profile rules
    match /users/{userId}/healthProfile/{document=**} {
      allow read, write: if isOwner(userId) && isEmailVerified();
    }

    // Symptom logs rules
    match /symptoms/{document=**} {
      allow read, write: if isOwner(resource.data.userId) && isEmailVerified();
    }

    // Community posts rules
    match /communityPosts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Allow users to update their own posts
        request.auth.uid == resource.data.userId ||
        // Allow increment-only updates for likes and comments
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments']) &&
          request.resource.data.likes >= resource.data.likes &&
          request.resource.data.comments >= resource.data.comments
        )
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }

    // Comments rules
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        // Allow users to update their own comments
        request.auth.uid == resource.data.userId ||
        // Allow increment-only updates for likes
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
          request.resource.data.likes >= resource.data.likes
        )
      );
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.userId;
    }
  }
}